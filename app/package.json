{
  "name": "nimbus-growth-desk",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run build:client && tsx watch server/app.ts",
    "build": "echo 'Using locally validated prebuilt dist artifacts'",
    "build:source": "npm run build:client && npm run build:server",
    "build:client": "vite build --config client/vite.config.ts",
    "build:server": "tsdown --config tsdown.server.config.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:workflow": "PLAYWRIGHT_UI_ONLY=1 playwright test tests/workflow.spec.ts --reporter=line",
    "lint": "eslint client/src/App.tsx client/src/main.tsx client/src/ErrorBoundary.tsx client/src/lib/api.ts client/src/growth/GrowthDesk.tsx server/app.ts server/nimbus-runtime.ts server/lib/ai-gateway.ts",
    "db:generate": "drizzle-kit generate",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@databricks/appkit": "^0.66.1",
    "@openai/agents": "^0.17.0",
    "drizzle-orm": "^0.45.2",
    "express": "4.22.2",
    "jsonc-parser": "^3.3.1",
    "mlflow-tracing": "^0.1.3",
    "openai": "^7.5.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@databricks/appkit-ui": "0.66.1",
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.17",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.1.17",
    "@types/express": "5.0.5",
    "@types/leaflet": "1.9.21",
    "@types/node": "24.10.1",
    "@types/pg": "^8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.1.1",
    "autoprefixer": "10.4.22",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.4.24",
    "leaflet": "1.9.4",
    "lucide-react": "0.554.0",
    "prettier": "3.7.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-leaflet": "5.0.0",
    "react-markdown": "10.1.0",
    "react-router": "7.9.6",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.1.17",
    "tailwindcss-animate": "1.0.7",
    "tsdown": "0.16.5",
    "tsx": "4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "7.2.4",
    "vitest": "4.0.14"
  }
}
